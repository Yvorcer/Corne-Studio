# Lets Corne Studio talk to Corne keyboards without root on Linux.
# Install:  sudo cp 99-corne-studio.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# foostan Corne (v1–v4, v4 mini)
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="4653", MODE="0660", TAG+="uaccess"
# Mechboards CRKBD Pro
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="7171", ATTRS{idProduct}=="0003", MODE="0660", TAG+="uaccess"
# Boardsource Unicorne
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="4273", ATTRS{idProduct}=="7563", MODE="0660", TAG+="uaccess"
